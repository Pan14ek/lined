VITE_API_BASE_URL=http://localhost:8080/api
VITE_ENABLE_MSW=true
VITE_USE_MOCKS=false
# Optional: artificial latency (ms) on MSW GET handlers, so skeletons are
# visible while developing. Leave unset for instant responses. Only meant
# for .env.local — Vite doesn't load .env.local in test mode, so this never
# slows down the test suite.
# VITE_MOCK_DELAY_MS=600
