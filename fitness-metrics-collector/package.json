{
  "name": "lined-metrics",
  "private": true,
  "devDependencies": {
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "@types/node": "22.0.0"
  },
  "scripts": {
    "metrics": "node -r ts-node/register scripts/collectMetrics.ts"
  },
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  }
}
